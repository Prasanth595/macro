  "query": "\n            SELECT tt.document_id AS \"document_id!\",\n                   a.review_on_open,\n                   a.complete_on_merge,\n                   a.reset_on_close\n            FROM team_task tt\n            INNER JOIN team_github_task_automation a ON a.team_id = tt.team_id\n            WHERE tt.document_id = ANY($1)\n            ",
